TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Модель с поддержкой изображений на входе и base64 data URL.
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-lite
# Для будущей итерации транскрипции; пока приложение не использует эту настройку.
OPENROUTER_AUDIO_MODEL=google/gemini-2.5-flash-lite
HISTORY_MAX_EXCHANGES=10
HISTORY_DIR=data/history
